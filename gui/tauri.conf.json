{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Redact GUI",
  "version": "0.4.0",
  "identifier": "solutions.linhan.redact-gui",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Redact GUI — Lộc Đặng",
        "width": 720,
        "height": 640,
        "minWidth": 660,
        "minHeight": 580,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../assets/examples/": "examples/"
    }
  }
}
